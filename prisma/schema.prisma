generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// An anime in the Zoko catalog (identified by its MyAnimeList ID,
// which is what Zoko's player URLs are keyed on:
// https://zokoanime.video/download/mal/{malId}/{episode}/{sub|dub})
model Anime {
  malId        Int      @id
  title        String
  titleEnglish String?
  image        String?
  banner       String?
  synopsis     String?
  type         String?  // TV, Movie, OVA, ONA, Special
  rating       String?  // e.g. "PG-13 - Teens 13 or older"
  ratingShort  String?  // e.g. "PG-13"
  status       String?  // "Currently Airing" | "Finished Airing" ...
  airing       Boolean  @default(false)
  season       String?  // Fall, Spring...
  year         Int?
  durationMin  Int?
  score        Float?
  rank         Int?
  popularity   Int?
  members      Int?
  genres       String   @default("[]") // JSON array of genre names
  studios      String   @default("[]") // JSON array
  trailerYt    String?
  totalEpisodes Int     @default(0) // known episode count from MAL
  inCatalog     Boolean @default(true) // "Zoko has it"
  hasDub        Boolean? // Zoko probe result: does a DUB stream exist? (null = not probed yet)
  source        String  @default("seed") // seed | season-import | manual
  lastSyncedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  episodes Episode[]

  @@index([inCatalog, popularity])
  @@index([airing])
  @@index([updatedAt])
}

// One playable episode (for one audio track) of an anime.
// Playback itself always goes through Zoko's player URL.
model Episode {
  id        String   @id @default(cuid())
  animeId   Int
  number    Int
  title     String?
  aired     String?  // ISO date string when it aired
  lang      String   @default("sub") // "sub" | "dub"
  filler    Boolean  @default(false)
  recap     Boolean  @default(false)
  addedAt   DateTime @default(now())

  anime Anime @relation(fields: [animeId], references: [malId], onDelete: Cascade)

  @@unique([animeId, number, lang])
  @@index([animeId, lang, number])
  @@index([addedAt])
}

// Log of each catalog sync run (episode import / new anime import)
model SyncLog {
  id            String   @id @default(cuid())
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  ok            Boolean  @default(false)
  episodesAdded Int      @default(0)
  animeAdded    Int      @default(0)
  animeChecked  Int      @default(0)
  detail        String?  // JSON summary or error
}

// A viewer profile. No passwords — the client generates an id (UUID) that is
// kept in localStorage; nickname + avatar live here so comments can show them.
model User {
  id        String   @id
  nickname  String   @default("Otaku")
  avatar    String? // small data-URL (client resizes to 160x160 JPEG)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress WatchProgress[]
  comments Comment[]
}

// Precise resume point for one (user, anime, episode): seconds watched out of
// total seconds. Powers Continue Watching, the red bars on episode buttons and
// "start where you were last".
model WatchProgress {
  id        String   @id @default(cuid())
  userId    String
  malId     Int
  episode   Int
  lang      String   @default("sub")
  server    String   @default("zoko")
  position  Float    @default(0) // seconds watched
  duration  Float    @default(0) // total seconds
  completed Boolean  @default(false)
  title     String? // snapshot so Continue Watching survives catalog churn
  image     String? // snapshot poster
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, malId, episode])
  @@index([userId, updatedAt])
  @@index([userId, malId])
}

// Aggregated in-app watch time per anime per calendar day — powers the
// "Top 10 Today" rail on Home. Empty until someone actually watches: rows
// only exist once real playback seconds have been recorded. `seconds`
// accumulates from player heartbeats while a video is ACTUALLY playing
// (paused/buffered/ended time never counts). `day` is the viewer's LOCAL
// calendar day ("YYYY-MM-DD"), so "today" matches each user's timezone.
model WatchStat {
  id        String   @id @default(cuid())
  day       String // "YYYY-MM-DD" (viewer's local calendar day)
  malId     Int
  seconds   Int      @default(0) // total seconds actually watched this day
  title     String? // title snapshot from the player session
  image     String? // poster snapshot from the player session
  updatedAt DateTime @updatedAt

  @@unique([day, malId])
  @@index([day, seconds])
  @@index([updatedAt])
}

// Top 10 Today membership-change event, surfaced in the bell notifications:
//   "enter" — anime appeared in a day's Top 10 (wasn't in the previous
//             published day's list)
//   "leave" — anime dropped out when a day published without it
// Deduped per (type, malId, day) so re-computations never double-notify.
model Top10Event {
  id        Int      @id @default(autoincrement())
  type      String // "enter" | "leave"
  malId     Int
  day       String // the Top 10 day the event belongs to ("YYYY-MM-DD")
  title     String
  image     String?
  rank      Int? // rank on the day it entered (null for leaves)
  createdAt DateTime @default(now())

  @@unique([type, malId, day])
  @@index([createdAt])
}

// Tiny KV store for Top 10 bookkeeping (last published/sealed day).
model Top10Meta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Community comment on an anime (shows nickname + avatar snapshot at post time).
// Supports one level of replies (parentId -> parent comment) and likes
// (likedBy = JSON array of userIds; count = array length, so double-likes are
// impossible per identity).
model Comment {
  id        String   @id @default(cuid())
  malId     Int
  userId    String
  nickname  String
  avatar    String?
  text      String
  parentId  String? // set when this comment is a reply
  likedBy   String   @default("[]") // JSON array of userIds who liked it
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  @@index([malId, createdAt])
  @@index([parentId])
}
